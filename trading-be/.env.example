PROJECT_NAME=HR_CV_Agent_Sys
PROJECT_DESCRIPTION="Agent Backend for extracting and filtering HR CVs"
PROJECT_VERSION=0.1.0

API_PREFIX=/api
DOC_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# Database — K8s: injected via hr-cv-app-secret; local: port-forward postgres
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/hr_system

# JWT & Auth
SECRET_KEY=dev-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configs — K8s: injected via hr-cv-app-secret
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM (Ollama-compatible, runs on-premise)
LOCAL_LLM_BASE_URL=http://192.168.50.150:11435
LOCAL_LLM_API_KEY=Tinhvan@2026
LOCAL_LLM_MODEL=qwen3.5:9b
# Set to true to use local LLM as default when OPENAI_API_KEY is absent
LOCAL_LLM_ENABLED=false

LOG_LEVEL=info

# Backend service — K8s: http://hr-cv-backend.hr-cv-app.svc.cluster.local
API_BASE_URL=http://localhost:8000

# Kafka — K8s: hr-cv-kafka.hr-cv-infra.svc.cluster.local:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID_AGENT=hr-cv-agent-group
# Topic names must match infra/helm/kafka/values.yaml `topics`
KAFKA_TOPIC_HR_CV=hr-cv
KAFKA_TOPIC_HR_JD=hr-jd
KAFKA_TOPIC_AGENT_RESULTS=agent-results

# MinIO — K8s: minio.hr-cv-infra.svc.cluster.local:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=hr-cv
MINIO_USE_SSL=false
# Public endpoint for presigned URLs (LAN IP or public domain)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
